# ====================================
# MVLT AI Service - Environment Configuration
# ====================================

# ----------------
# Application Settings
# ----------------
APP_NAME=MVLT AI Service
APP_VERSION=0.1.0
APP_DEBUG=false

# ----------------
# Server Configuration
# ----------------
HOST=0.0.0.0
PORT=8765

# ----------------
# Claude API Configuration (REQUIRED)
# ----------------
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-api-key-here

# Claude model to use (default: claude-sonnet-4-5)
CLAUDE_MODEL=claude-sonnet-4-5

# Maximum tokens in Claude responses (default: 1000)
CLAUDE_MAX_TOKENS=1000

# Temperature for Claude responses 0.0-1.0 (default: 0.7)
CLAUDE_TEMPERATURE=0.7

# ----------------
# CORS Configuration
# ----------------
# Comma-separated list of allowed origins
# Use "*" to allow all origins (development only)
# Production example: CORS_ORIGINS=https://app.mvlt.com,https://mvlt.com
CORS_ORIGINS=*

# ----------------
# Content Validation Limits
# ----------------
# Maximum length for journal entry content (default: 10000)
MAX_ENTRY_CONTENT_LENGTH=10000

# Maximum length for chat messages (default: 5000)
MAX_CHAT_MESSAGE_LENGTH=5000

# Maximum length for title generation content (default: 1500)
MAX_TITLE_CONTENT_LENGTH=1500
